---
import '../styles/tokens.css';
import '../styles/buttons.css';
import '../styles/sections.css';
import Analytics from '../components/Analytics.astro';
import LanguageSelect from '../components/LanguageSelect.astro';
import TrialModal from '../components/TrialModal.astro';
import {
  getLocaleFromPath,
  getLocaleMetadata,
  getTranslations,
  localizePath,
  normalizeLocale,
  SUPPORTED_LOCALES,
  type LocaleInput,
} from '../lib/i18n';
import { u } from '../lib/site';
import pkg from '../../package.json';

const year = new Date().getFullYear();

interface Props {
  title: string;
  description?: string;
  /** Unprefixed canonical path of this page (default '/'); locale is added automatically. */
  canonicalPath?: string;
  brandName?: string;
  /** Locale supplied by a localized route wrapper; omitted means infer from the URL. */
  locale?: LocaleInput;
}

const SITE = 'https://airmino.com';

const {
  title,
  description,
  canonicalPath = '/',
  brandName = 'Airmino',
  locale: requestedLocale,
} = Astro.props;
const locale = normalizeLocale(requestedLocale ?? getLocaleFromPath(Astro.url.pathname));
const localeMetadata = getLocaleMetadata(locale);
const translations = getTranslations(locale);
const metaDescription = description ?? translations.meta.description;
const canonical = SITE + localizePath(canonicalPath, locale);
const alternateLinks = SUPPORTED_LOCALES.map((alternateLocale) => ({
  locale: alternateLocale,
  href: SITE + localizePath(canonicalPath, alternateLocale),
}));
const localizedPath = (path: string) => u(localizePath(path, locale));
---

<!doctype html>
<html lang={localeMetadata.languageTag} dir={localeMetadata.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <link rel="apple-touch-icon" href={u('/favicon.png')} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {alternateLinks.map(({ locale: alternateLocale, href }) => (
      <link rel="alternate" hreflang={alternateLocale} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={SITE + localizePath(canonicalPath, 'en')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Airmino" />
    <meta property="og:locale" content={localeMetadata.languageTag} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
          <a class="brand" href={localizedPath('/')} aria-label={brandName}>
          <img src={u('/logo-1.png')} alt={brandName} class="brand-logo" width="151" height="40" />
        </a>
        <nav class="nav-links" aria-label={translations.common.primaryNavigation}>
          <a href={localizedPath('/usage/')}>{translations.nav.usageStories}</a>
          <a href={localizedPath('/roi-calculator/')}>{translations.nav.roiCalculator}</a>
          <a href={localizedPath('/#pricing')}>{translations.nav.pricing}</a>
        </nav>
        <div class="nav-right">
          <LanguageSelect locale={locale} />
          <a class="btn btn-primary btn-sm" href={localizedPath('/#start')} data-trial-open data-event="cta-start-trial">{translations.common.startFreeTrial}</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="wrap foot-links">
        <div class="foot-col">
          <span class="foot-h">{translations.footer.product}</span>
          <a href={localizedPath('/usage/')}>{translations.nav.usageStories}</a>
          <a href={localizedPath('/roi-calculator/')}>{translations.nav.roiCalculator}</a>
          <a href={localizedPath('/#pricing')}>{translations.nav.pricing}</a>
        </div>
        <div class="foot-col">
          <span class="foot-h">{translations.footer.resources}</span>
          <a href={localizedPath('/gdpr/')} data-event="footer-gdpr">{translations.nav.gdpr}</a>
          <a href={localizedPath('/#benchmarks')}>{translations.footer.benchmarkMethodology}</a>
          <a href={localizedPath('/#architecture')}>{translations.footer.architectureFaq}</a>
        </div>
        <div class="foot-col">
          <span class="foot-h">{translations.footer.evaluate}</span>
          <a href={localizedPath('/usage/#fraud-detection')}>{translations.footer.fraudDetection}</a>
          <a href={localizedPath('/usage/#support-routing')}>{translations.footer.supportRouting}</a>
          <a href={localizedPath('/usage/#loan-prequal')}>{translations.footer.loanPrequalification}</a>
        </div>
      </div>
      <div class="wrap foot-bottom">
        <span>© {year} airmino.com</span>
        <span>{translations.footer.infrastructureNote}</span>
        <span><a href="https://github.com/gbalabanli/AirminoWebsite/blob/main/LICENSE" data-event="footer-license">{translations.footer.mitLicence}</a> · v{pkg.version}</span>
      </div>
    </footer>
    <TrialModal locale={locale} />
    <Analytics />
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 32px;
    height: 66px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.03em;
  }
  .brand-logo {
    height: 40px;
    width: auto;
    display: block;
  }
  .nav-links {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 26px;
    font-size: 14px;
    color: var(--muted);
    font-weight: 520;
  }
  .nav-links a:hover {
    color: var(--ink);
  }
  .nav-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  /* Note: .btn styles come from the global buttons.css (single definition). */
  footer {
    background: var(--ink-2);
    color: #7c87a3;
    padding: 44px 0 30px;
    font-size: 13.5px;
  }
  .foot-links {
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
    padding-bottom: 28px;
    margin-bottom: 22px;
    border-bottom: 1px solid #242e48;
  }
  .foot-col {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 150px;
  }
  .foot-h {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: #aab4cc;
    margin-bottom: 4px;
  }
  .foot-col a {
    font-size: 13.5px;
  }
  .foot-col a:hover {
    color: #fff;
  }
  .foot-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 12.5px;
  }
  .foot-bottom a:hover {
    color: #fff;
  }
  @media (max-width: 980px) {
    .nav-links {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .nav-inner {
      gap: 12px;
    }
    .brand-logo {
      width: 116px;
      height: auto;
    }
    .nav-right {
      gap: 8px;
    }
    .nav-right .btn-sm {
      padding-inline: 10px;
      font-size: 12.5px;
    }
  }
  @media (max-width: 400px) {
    .nav-inner {
      gap: 8px;
    }
    .brand-logo {
      width: 94px;
    }
  }
</style>
