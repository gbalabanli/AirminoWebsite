---
import '../styles/tokens.css';
import '../styles/buttons.css';
import '../styles/sections.css';
import Analytics from '../components/Analytics.astro';
import { u } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Canonical path of this page (default '/'). Joined with SITE for canonical + og:url. */
  canonicalPath?: string;
  brandName?: string;
}

const SITE = 'https://airmino.com';

const {
  title,
  description = 'Decision infrastructure for automated operations.',
  canonicalPath = '/',
  brandName = 'Airmino',
} = Astro.props;
const canonical = SITE + canonicalPath;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <link rel="apple-touch-icon" href={u('/favicon.png')} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Airmino" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href={u('/')} aria-label={brandName}>
          <img src={u('/logo-1.png')} alt={brandName} class="brand-logo" />
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={u('/')}>Platform</a>
          <a href={u('/case-studies/ledgerline/')}>Case Studies</a>
          <a href={u('/roi-calculator/')}>ROI Calculator</a>
        </nav>
        <div class="nav-right">
          <a class="btn btn-primary btn-sm" href={u('/#start')}>Start free trial</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="wrap foot-bottom">
        <span>© 2025 Airmino, Inc.</span>
        <span>SOC 2 Type II · GDPR · VPC &amp; self-hosted</span>
      </div>
    </footer>
    <Analytics />
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    height: 66px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.03em;
  }
  .brand-logo {
    height: 40px;
    width: auto;
    display: block;
  }
  .nav-links {
    display: flex;
    gap: 26px;
    font-size: 14px;
    color: var(--muted);
    font-weight: 520;
  }
  .nav-links a:hover {
    color: var(--ink);
  }
  .nav-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  /* Note: .btn styles come from the global buttons.css (single definition). */
  footer {
    background: var(--ink-2);
    color: #7c87a3;
    padding: 34px 0;
    font-size: 13.5px;
  }
  .foot-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 12.5px;
  }
  @media (max-width: 980px) {
    .nav-links {
      display: none;
    }
  }
</style>
