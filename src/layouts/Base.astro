---
import '../styles/tokens.css';
import '../styles/buttons.css';
import '../styles/sections.css';
import Analytics from '../components/Analytics.astro';
import TrialModal from '../components/TrialModal.astro';
import { u } from '../lib/site';
import pkg from '../../package.json';

const year = new Date().getFullYear();

interface Props {
  title: string;
  description?: string;
  /** Canonical path of this page (default '/'). Joined with SITE for canonical + og:url. */
  canonicalPath?: string;
  brandName?: string;
}

const SITE = 'https://airmino.com';

const {
  title,
  description = 'Decision infrastructure for automated operations.',
  canonicalPath = '/',
  brandName = 'Airmino',
} = Astro.props;
const canonical = SITE + canonicalPath;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={u('/favicon.png')} />
    <link rel="apple-touch-icon" href={u('/favicon.png')} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Airmino" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href={u('/')} aria-label={brandName}>
          <img src={u('/logo-1.png')} alt={brandName} class="brand-logo" />
        </a>
        <nav class="nav-links" aria-label="Primary">
          <a href={u('/usage/')}>Usage</a>
          <a href={u('/roi-calculator/')}>ROI Calculator</a>
          <a href={u('/#pricing')}>Pricing</a>
        </nav>
        <div class="nav-right">
          <a class="btn btn-primary btn-sm" href={u('/#start')} data-trial-open data-event="cta-start-trial">Start free trial</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="wrap foot-links">
        <div class="foot-col">
          <span class="foot-h">Product</span>
          <a href={u('/usage/')}>Usage stories</a>
          <a href={u('/roi-calculator/')}>ROI calculator</a>
          <a href={u('/#pricing')}>Pricing</a>
        </div>
        <div class="foot-col">
          <span class="foot-h">Resources</span>
          <a href={u('/gdpr/')} data-event="footer-gdpr">GDPR &amp; data processing</a>
          <a href={u('/#benchmarks')}>Benchmark methodology</a>
          <a href={u('/#architecture')}>Architecture FAQ</a>
        </div>
        <div class="foot-col">
          <span class="foot-h">Evaluate</span>
          <a href={u('/usage/#fraud-detection')}>Fraud detection</a>
          <a href={u('/usage/#support-routing')}>Support routing</a>
          <a href={u('/usage/#loan-prequal')}>Loan pre-qual</a>
        </div>
      </div>
      <div class="wrap foot-bottom">
        <span>© {year} airmino.com</span>
        <span>VPC or self-hosted · No training on your data</span>
        <span><a href="https://github.com/gbalabanli/AirminoWebsite/blob/main/LICENSE" data-event="footer-license">MIT licence</a> · v{pkg.version}</span>
      </div>
    </footer>
    <TrialModal />
    <Analytics />
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 32px;
    height: 66px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.03em;
  }
  .brand-logo {
    height: 40px;
    width: auto;
    display: block;
  }
  .nav-links {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 26px;
    font-size: 14px;
    color: var(--muted);
    font-weight: 520;
  }
  .nav-links a:hover {
    color: var(--ink);
  }
  .nav-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  /* Note: .btn styles come from the global buttons.css (single definition). */
  footer {
    background: var(--ink-2);
    color: #7c87a3;
    padding: 44px 0 30px;
    font-size: 13.5px;
  }
  .foot-links {
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
    padding-bottom: 28px;
    margin-bottom: 22px;
    border-bottom: 1px solid #242e48;
  }
  .foot-col {
    display: flex;
    flex-direction: column;
    gap: 9px;
    min-width: 150px;
  }
  .foot-h {
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: #aab4cc;
    margin-bottom: 4px;
  }
  .foot-col a {
    font-size: 13.5px;
  }
  .foot-col a:hover {
    color: #fff;
  }
  .foot-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 12.5px;
  }
  .foot-bottom a:hover {
    color: #fff;
  }
  @media (max-width: 980px) {
    .nav-links {
      display: none;
    }
  }
</style>
