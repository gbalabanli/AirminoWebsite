---
import BeforeAfterTable from './BeforeAfterTable.astro';

/* Interactive ROI calculator. The math (money/compact/calc/bind) is a
   verbatim port of the <script> in docs/design/index.html; only wiring
   changed (page-router calls removed, real route links used).
   A11y additions vs the prototype: <label for> associations and
   aria-live="polite" on the results region. */
---

<div class="wrap calc-grid">
  <div class="panel">
    <h3>Your current operation</h3>
    <p class="sub">// drag or type to adjust</p>

    <div class="field">
      <label for="volume">Decisions per month</label>
      <input type="range" id="volumeRange" min="10000" max="5000000" step="10000" value="250000" aria-label="Decisions per month (slider)" />
      <div class="num-input">
        <span>#</span>
        <input type="number" id="volume" value="250000" min="1000" step="1000" />
      </div>
      <div class="hint" id="volumeHint">250,000 decisions / month</div>
    </div>

    <div class="field">
      <label for="cost">Current cost per decision</label>
      <input type="range" id="costRange" min="0.01" max="5" step="0.01" value="0.85" aria-label="Current cost per decision (slider)" />
      <div class="num-input">
        <span>$</span>
        <input type="number" id="cost" value="0.85" min="0.01" step="0.01" />
      </div>
      <div class="hint">Include analyst time, tooling and infra</div>
    </div>

    <div class="field">
      <label for="rate">Verdict rate per 1,000 decisions</label>
      <input type="range" id="rateRange" min="0.01" max="0.20" step="0.005" value="0.04" aria-label="Verdict rate per 1,000 decisions (slider)" />
      <div class="num-input">
        <span>$</span>
        <input type="number" id="rate" value="0.04" min="0.01" step="0.005" />
      </div>
      <div class="hint">List price $0.04 · volume tiers to $0.018</div>
    </div>

    <div class="field">
      <label for="platform">Monthly platform fee</label>
      <div class="num-input">
        <span>$</span>
        <input type="number" id="platform" value="0" min="0" step="100" />
      </div>
      <div class="hint">Set to 0 for usage-only pricing</div>
    </div>

    <div class="calc-note">
      <b>Note:</b> these are directional estimates. Your actual numbers depend on
      escalation thresholds, deployment topology and contract tier.
    </div>
  </div>

  <div>
    <div class="results" aria-live="polite">
      <div class="result hero-res">
        <div class="rl">Projected annual savings</div>
        <div class="rv" id="annualSavings">$2,430,000</div>
        <div class="rs" id="annualSub">Based on 250,000 decisions/month at $0.85 today</div>
      </div>

      <div class="result">
        <div class="rl">Monthly savings</div>
        <div class="rv" id="monthlySavings">$202,500</div>
        <div class="rs" id="monthlySub">Net of Verdict spend</div>
      </div>

      <div class="result">
        <div class="rl">Cost reduction</div>
        <div class="rv" id="reduction">95.3%</div>
        <div class="rs">Per-decision cost, before vs. after</div>
      </div>
    </div>

    <div class="panel">
      <h3>Cost comparison</h3>
      <p class="sub">// monthly, all-in</p>

      <div class="bars">
        <div class="bar-row">
          <div class="bl">
            <span>Current cost</span>
            <span class="bv old" id="barOldLabel">$212,500 / mo</span>
          </div>
          <div class="bar"><i class="old" id="barOld" style="width:100%"></i></div>
        </div>

        <div class="bar-row">
          <div class="bl">
            <span>With Verdict</span>
            <span class="bv new" id="barNewLabel">$10,000 / mo</span>
          </div>
          <div class="bar"><i class="new" id="barNew" style="width:5%"></i></div>
        </div>
      </div>

      <div class="calc-ba">
        <BeforeAfterTable
          headers={['Line item', 'Current', 'With Verdict']}
          rows={[
            { name: 'Monthly decision cost', before: '$212,500', after: '$10,000', beforeId: 'tblOld', afterId: 'tblNew' },
            { name: 'Annual decision cost', before: '$2,550,000', after: '$120,000', beforeId: 'tblOldYr', afterId: 'tblNewYr' },
            { name: 'Cost per decision', before: '$0.8500', after: '$0.0400', beforeId: 'tblOldUnit', afterId: 'tblNewUnit' },
          ]}
        />
      </div>
    </div>
  </div>
</div>

<script>
/* ---------- CALCULATOR (verbatim port) ---------- */
const vol = document.getElementById('volume');
const volRange = document.getElementById('volumeRange');
const cost = document.getElementById('cost');
const costRange = document.getElementById('costRange');
const rate = document.getElementById('rate');
const rateRange = document.getElementById('rateRange');
const platform = document.getElementById('platform');

function money(n, dec) {
  dec = dec === undefined ? 0 : dec;
  return '$' + n.toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec });
}
function compact(n) {
  if (n >= 1e6) return '$' + (n / 1e6).toFixed(2) + 'M';
  if (n >= 1e3) return '$' + Math.round(n / 1e3) + 'k';
  return money(n);
}

function calc() {
  const v = Math.max(1, Number(vol.value) || 0);
  const c = Math.max(0.001, Number(cost.value) || 0);
  const r = Math.max(0.001, Number(rate.value) || 0);
  const pf = Math.max(0, Number(platform.value) || 0);

  const oldMonthly = v * c;
  const newMonthly = (v / 1000) * r + pf;

  const monthlySave = oldMonthly - newMonthly;
  const annualSave = monthlySave * 12;
  const reduction = oldMonthly > 0 ? (1 - newMonthly / oldMonthly) * 100 : 0;

  const newUnit = newMonthly / v;

  /* hero result */
  document.getElementById('annualSavings').textContent =
    annualSave >= 0 ? compact(annualSave) : '-' + compact(Math.abs(annualSave));
  document.getElementById('annualSub').textContent =
    'Based on ' + v.toLocaleString() + ' decisions/month at ' + money(c, 2) + ' today';

  document.getElementById('monthlySavings').textContent =
    monthlySave >= 0 ? compact(monthlySave) : '-' + compact(Math.abs(monthlySave));
  document.getElementById('monthlySub').textContent =
    'Net of ' + compact(newMonthly) + ' in Verdict spend';

  document.getElementById('reduction').textContent =
    (reduction >= 0 ? reduction.toFixed(1) : '0.0') + '%';

  /* bars */
  const max = Math.max(oldMonthly, newMonthly) || 1;
  const oldPct = (oldMonthly / max) * 100;
  const newPct = Math.max(1.5, (newMonthly / max) * 100);

  document.getElementById('barOld').style.width = oldPct + '%';
  document.getElementById('barNew').style.width = newPct + '%';
  document.getElementById('barOldLabel').textContent = compact(oldMonthly) + ' / mo';
  document.getElementById('barNewLabel').textContent = compact(newMonthly) + ' / mo';

  /* table */
  document.getElementById('tblOld').textContent = money(oldMonthly);
  document.getElementById('tblNew').textContent = money(newMonthly);
  document.getElementById('tblOldYr').textContent = money(oldMonthly * 12);
  document.getElementById('tblNewYr').textContent = money(newMonthly * 12);
  document.getElementById('tblOldUnit').textContent = money(c, 4);
  document.getElementById('tblNewUnit').textContent = money(newUnit, 4);

  /* hint */
  document.getElementById('volumeHint').textContent =
    v.toLocaleString() + ' decisions / month';
}

/* range <-> number syncing */
function bind(rangeEl, numEl) {
  rangeEl.addEventListener('input', () => {
    numEl.value = rangeEl.value;
    calc();
  });
  numEl.addEventListener('input', () => {
    const v = Number(numEl.value);
    if (!isNaN(v)) rangeEl.value = v;
    calc();
  });
}
bind(volRange, vol);
bind(costRange, cost);
bind(rateRange, rate);
platform.addEventListener('input', calc);

calc();
</script>

<style>
  .calc-grid {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 40px;
    padding: 56px 24px 80px;
  }
  .panel {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 28px;
  }
  .panel h3 {
    font-size: 16px;
    margin-bottom: 6px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 680;
  }
  .panel .sub {
    font-size: 13px;
    color: var(--muted-2);
    margin-bottom: 24px;
    font-family: var(--mono);
  }
  .field {
    margin-bottom: 22px;
  }
  .field label {
    display: block;
    font-size: 13.5px;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .field .hint {
    font-size: 12px;
    color: var(--muted-2);
    margin-top: 6px;
    font-family: var(--mono);
  }
  .field input[type="range"] {
    width: 100%;
    accent-color: var(--accent);
    margin-bottom: 10px;
  }
  .field .num-input {
    display: flex;
    align-items: center;
    border: 1px solid var(--line);
    border-radius: 9px;
    overflow: hidden;
    background: #fff;
  }
  .field .num-input span {
    padding: 0 12px;
    color: var(--muted-2);
    font-family: var(--mono);
    font-size: 13px;
    background: var(--paper-2);
    align-self: stretch;
    display: flex;
    align-items: center;
    border-right: 1px solid var(--line);
  }
  .field .num-input input {
    border: none;
    outline: none;
    padding: 10px 12px;
    font-family: var(--mono);
    font-size: 14px;
    width: 100%;
    font-weight: 600;
    color: var(--ink);
    background: transparent;
  }
  .results {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-bottom: 24px;
  }
  .result {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
    background: #fff;
  }
  .result.hero-res {
    grid-column: 1 / -1;
    background: var(--ink);
    color: #fff;
    border-color: var(--ink);
    position: relative;
    overflow: hidden;
  }
  .result.hero-res::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(500px 220px at 88% 0%, rgba(0, 200, 150, 0.2), transparent 62%);
  }
  .result.hero-res > * {
    position: relative;
  }
  .result .rl {
    font-size: 12.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-2);
    font-weight: 640;
    margin-bottom: 12px;
  }
  .result.hero-res .rl {
    color: #7c87a3;
  }
  .result .rv {
    font-family: var(--mono);
    font-size: 38px;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--accent);
  }
  .result.hero-res .rv {
    color: var(--mint);
    font-size: 52px;
  }
  .result .rs {
    font-size: 13px;
    color: var(--muted);
    margin-top: 8px;
    line-height: 1.5;
  }
  .result.hero-res .rs {
    color: #9aa4be;
  }
  .bars {
    margin-top: 8px;
  }
  .bar-row {
    margin-bottom: 22px;
  }
  .bar-row:last-child {
    margin-bottom: 0;
  }
  .bar-row .bl {
    display: flex;
    justify-content: space-between;
    font-size: 13.5px;
    margin-bottom: 8px;
    font-weight: 560;
  }
  .bar-row .bl .bv {
    font-family: var(--mono);
    font-weight: 660;
  }
  .bar {
    height: 12px;
    border-radius: 6px;
    background: var(--paper-2);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .bar i {
    display: block;
    height: 100%;
    border-radius: 5px;
    transition: width 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .bar i.old {
    background: linear-gradient(90deg, #ff8b6e, #ff6b4a);
  }
  .bar i.new {
    background: linear-gradient(90deg, #00e0a8, #00c896);
  }
  .bar-row .bv.old {
    color: var(--warn);
  }
  .bar-row .bv.new {
    color: var(--mint);
  }
  .calc-note {
    background: var(--mint-soft);
    border: 1px solid #b9eedd;
    border-radius: 12px;
    padding: 18px 20px;
    font-size: 13.5px;
    color: #0a6b52;
    line-height: 1.6;
  }
  .calc-note b {
    font-weight: 680;
  }
  /* BeforeAfterTable renders its own 30px vertical margin; neutralize it
     inside the calculator's cost-comparison panel to match the prototype. */
  .calc-ba {
    margin-top: 34px;
  }
  .calc-ba :global(.ba) {
    margin: 0;
  }
  @media (max-width: 980px) {
    .calc-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .results {
      grid-template-columns: 1fr;
    }
  }
</style>
