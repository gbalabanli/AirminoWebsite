---
import { getHomeCopy, type LocaleInput } from '../lib/i18n/home';

interface Props {
  locale?: LocaleInput;
}

const { locale } = Astro.props;
const copy = getHomeCopy(locale);
---

<section class="band">
  <div class="wrap">
    <div class="sec-head">
      <div class="kicker">{copy.metrics.kicker}</div>
      <h2>{copy.metrics.title}</h2>
      <p>{copy.metrics.description}</p>
    </div>
    <div class="metrics">
      {copy.metrics.items.map((item) => (
        <div class="metric">
          <span class={`val ${item.tone}`}>{item.value}</span>
          <div class="lbl">
            {item.label.map((part) => part.kind === 'strong' ? <b>{part.value}</b> : part.value)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .metric {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px 22px;
    transition: 0.18s;
  }
  .metric:hover {
    border-color: #c9d0e4;
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  .metric .val {
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.04em;
    font-family: var(--mono);
    margin-bottom: 6px;
    display: block;
  }
  .metric .val.a {
    color: var(--accent);
  }
  .metric .val.m {
    color: var(--mint-ink);
  }
  .metric .lbl {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.5;
  }
  @media (max-width: 980px) {
    .metrics {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .metrics {
      grid-template-columns: 1fr;
    }
  }
</style>
