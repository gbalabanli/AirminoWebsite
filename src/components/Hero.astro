---
import Terminal from './Terminal.astro';
---

<div class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow"><span class="dot"></span> Decision infrastructure</div>
      <h1>Make <em>1 million</em> operational decisions per hour.</h1>
      <p class="lede">
        Calibrated, machine-readable judgments your systems can act on.
        No text generation. No hallucination. <strong>$0.04 per thousand calls.</strong>
      </p>
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href="#start">Start 10,000-decision trial</a>
        <a class="btn btn-ghost btn-lg" href="#architecture">Read the architecture paper →</a>
      </div>
      <div class="micro">No credit card · SOC 2 Type II · VPC or self-hosted</div>
    </div>

    <Terminal />
  </div>

  <div class="wrap">
    <div class="logo-strip">
      <p>Running decision workloads at</p>
      <div class="logos">
        <span>LEDGERLINE</span><span>Northwind</span><span>ARCADIA</span>
        <span>Meridian Health</span><span>Byteline</span><span>OKTAVE</span>
      </div>
    </div>
  </div>
</div>

<style>
  .hero {
    background:
      radial-gradient(900px 480px at 78% -10%, rgba(59, 91, 255, 0.1), transparent 62%),
      radial-gradient(700px 400px at 8% 0%, rgba(0, 200, 150, 0.07), transparent 60%),
      var(--paper);
    border-bottom: 1px solid var(--line);
    padding: 78px 0 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12.5px;
    font-weight: 640;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid #dde3ff;
    padding: 6px 13px;
    border-radius: 100px;
    margin-bottom: 22px;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 0 3px rgba(0, 200, 150, 0.18);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    50% {
      box-shadow: 0 0 0 6px rgba(0, 200, 150, 0.05);
    }
  }
  .hero h1 {
    font-size: clamp(34px, 4.4vw, 54px);
    font-weight: 700;
    letter-spacing: -0.035em;
    margin-bottom: 20px;
    line-height: 1.15;
  }
  .hero h1 em {
    font-style: normal;
    background: linear-gradient(180deg, transparent 62%, rgba(59, 91, 255, 0.22) 62%);
    padding: 0 2px;
  }
  .lede {
    font-size: 17.5px;
    color: var(--muted);
    max-width: 520px;
    margin-bottom: 30px;
    line-height: 1.62;
  }
  .lede strong {
    color: var(--ink);
    font-weight: 640;
  }
  .logo-strip {
    padding: 34px 0 40px;
    margin-top: 56px;
    border-top: 1px solid var(--line);
  }
  .logo-strip p {
    font-size: 11.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted-2);
    font-weight: 640;
    text-align: center;
    margin-bottom: 22px;
  }
  .logos {
    display: flex;
    justify-content: center;
    gap: 52px;
    flex-wrap: wrap;
    align-items: center;
  }
  .logos span {
    font-size: 17px;
    font-weight: 700;
    color: #b4bbce;
    letter-spacing: -0.03em;
  }
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
  }
  @media (max-width: 600px) {
    .logos {
      gap: 28px;
    }
  }
</style>
