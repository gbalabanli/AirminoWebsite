---
import { getHomeCopy, type LocaleInput } from '../lib/i18n/home';

interface Props {
  locale?: LocaleInput;
}

const { locale } = Astro.props;
const copy = getHomeCopy(locale);
---

<section class="band alt" id="benchmarks">
  <div class="wrap">
    <div class="sec-head">
      <div class="kicker">{copy.benchmark.kicker}</div>
      <h2>{copy.benchmark.title}</h2>
      <p>{copy.benchmark.description}</p>
    </div>
    <div class="tbl-wrap">
      <table>
        <thead>
          <tr>
            {copy.benchmark.headers.map((header, index) => (
              <th class:list={[index === 4 && 'hi']}>{header}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {copy.benchmark.rows.map((row) => (
            <tr>
              <td>{row.label}</td>
              {row.cells.map((cell, index) => (
                <td class:list={[cell.kind === 'number' && 'num', index === 3 && 'hi']}>
                  {cell.kind === 'yes' ? <span class="yes">{cell.value}</span> : cell.kind === 'no' ? <span class="no">{cell.value}</span> : cell.value}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="tbl-note">{copy.benchmark.note}</p>
  </div>
</section>

<style>
  .tbl-wrap {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }
  th,
  td {
    padding: 14px 18px;
    text-align: left;
    border-bottom: 1px solid var(--line);
  }
  thead th {
    background: var(--ink);
    color: #fff;
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-weight: 640;
  }
  thead th.hi {
    background: var(--accent);
  }
  tbody tr:last-child td {
    border-bottom: none;
  }
  tbody tr:hover {
    background: var(--paper-2);
  }
  td.num {
    font-family: var(--mono);
    font-size: 13.4px;
  }
  .yes {
    color: var(--mint-ink);
    font-weight: 700;
  }
  .no {
    color: var(--warn-ink);
    font-weight: 700;
  }
  td.hi {
    background: var(--accent-soft);
    font-weight: 600;
  }
  .tbl-note {
    font-size: 12.5px;
    color: var(--muted-2);
    margin-top: 12px;
    font-family: var(--mono);
  }
</style>
