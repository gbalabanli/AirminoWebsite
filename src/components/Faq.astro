---
import { getHomeCopy, type LocaleInput } from '../lib/i18n/home';

interface Props {
  locale?: LocaleInput;
}

const { locale } = Astro.props;
const copy = getHomeCopy(locale);
---

<section class="band" id="architecture">
  <div class="wrap">
    <div class="sec-head">
      <div class="kicker">{copy.faq.kicker}</div>
      <h2>{copy.faq.title}</h2>
      <p>{copy.faq.description}</p>
    </div>
    <div class="faq">
      {copy.faq.items.map((item) => (
        <div class="q">
          <h3>{item.question}</h3>
          <p>{item.answer.map((part) => part.kind === 'code' ? <code>{part.value}</code> : part.value)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .q {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 24px;
  }
  .q h3 {
    font-size: 15px;
    margin-bottom: 9px;
    display: flex;
    gap: 10px;
    align-items: flex-start;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 680;
  }
  .q h3::before {
    content: "?";
    font-family: var(--mono);
    color: var(--accent);
    font-weight: 800;
    flex-shrink: 0;
  }
  .q p {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.65;
    padding-left: 22px;
  }
  .q p code {
    font-family: var(--mono);
    font-size: 12.5px;
    background: var(--paper-2);
    padding: 1px 5px;
    border-radius: 4px;
    border: 1px solid var(--line);
  }
  @media (max-width: 980px) {
    .faq {
      grid-template-columns: 1fr;
    }
  }
</style>
