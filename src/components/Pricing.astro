---
/* Pricing matrix ported from docs/design/prototype_version_2.html #pricing
   (Developer $0 / Growth $239 / Enterprise Custom + monthly/annual switcher),
   re-skinned to Airmino tokens. Figures are placeholders until a real pricing
   decision lands — see docs/content-sources.md. Vanilla toggle, no framework. */
import { u } from '../lib/site';
const growthMonthly = 239;
const growthAnnual = Math.round(growthMonthly * 0.8);
---

<section class="band" id="pricing">
  <div class="wrap">
    <div class="sec-head pricing-head">
      <div class="kicker">Transparent billing</div>
      <h2>Predictable platform tiers.</h2>
      <p>Scale from MVP to enterprise without overage surprises. Every tier is the same decision API.</p>
      <div class="billing-toggle" role="group" aria-label="Billing period">
        <button type="button" id="bill-monthly" aria-pressed="false" data-event="pricing-billing-monthly">Monthly</button>
        <button type="button" id="bill-annual" aria-pressed="true" class="is-active" data-event="pricing-billing-annual">
          Annual <span class="save">Save 20%</span>
        </button>
      </div>
    </div>

    <div class="tiers">
      <div class="tier">
        <h3>Developer</h3>
        <p class="tier-sub">Free tier for MVPs &amp; side projects.</p>
        <div class="price"><span class="amount">$0</span><span class="per">/ month</span></div>
        <ul>
          <li>100,000 requests / mo</li>
          <li>3-region edge replication</li>
          <li>Community support</li>
        </ul>
        <a class="btn btn-ghost" href={u('/#start')} data-trial-open data-event="pricing-start-developer">Get started free</a>
      </div>

      <div class="tier tier-featured">
        <div class="flag">Most popular</div>
        <h3>Growth</h3>
        <p class="tier-sub">For scaling teams with heavy API volume.</p>
        <div class="price">
          <span class="amount" id="price-growth" data-monthly={`$${growthMonthly}`} data-annual={`$${growthAnnual}`}>${growthAnnual}</span><span class="per">/ month</span>
        </div>
        <p class="bill-note" id="bill-note">billed annually</p>
        <ul>
          <li>10,000,000 requests / mo</li>
          <li>Global anycast routing</li>
          <li>99.99% SLA uptime</li>
          <li>Dedicated solutions channel</li>
        </ul>
        <a class="btn btn-primary" href={u('/#start')} data-trial-open data-event="pricing-trial-growth">Start 14-day free trial</a>
      </div>

      <div class="tier">
        <h3>Enterprise</h3>
        <p class="tier-sub">Private VPC isolation &amp; custom SLAs.</p>
        <div class="price"><span class="amount">Custom</span></div>
        <ul>
          <li>Unlimited request volume</li>
          <li>Private isolated VPC cluster</li>
          <li>99.999% SLA uptime</li>
          <li>BAA &amp; security audits</li>
        </ul>
        <a class="btn btn-ghost" href={u('/#start')} data-trial-open data-trial-interest="sales" data-event="pricing-contact-enterprise">Talk to sales</a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var monthly = document.getElementById('bill-monthly');
    var annual = document.getElementById('bill-annual');
    var price = document.getElementById('price-growth');
    var note = document.getElementById('bill-note');
    if (!monthly || !annual || !price) return;
    function set(mode) {
      var isAnnual = mode === 'annual';
      monthly.classList.toggle('is-active', !isAnnual);
      annual.classList.toggle('is-active', isAnnual);
      monthly.setAttribute('aria-pressed', String(!isAnnual));
      annual.setAttribute('aria-pressed', String(isAnnual));
      price.textContent = isAnnual ? price.getAttribute('data-annual') : price.getAttribute('data-monthly');
      if (note) note.textContent = isAnnual ? 'billed annually' : 'billed monthly';
    }
    monthly.addEventListener('click', function () { set('monthly'); });
    annual.addEventListener('click', function () { set('annual'); });
  })();
</script>

<style>
  .pricing-head {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }
  .billing-toggle {
    display: inline-flex;
    gap: 4px;
    margin-top: 24px;
    padding: 5px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper-2);
  }
  .billing-toggle button {
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .billing-toggle button.is-active {
    background: #fff;
    color: var(--accent);
    border-color: var(--line);
    box-shadow: var(--shadow);
  }
  .billing-toggle .save {
    font-size: 10px;
    text-transform: uppercase;
    font-weight: 700;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 2px 6px;
    border-radius: 5px;
    margin-left: 4px;
  }
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }
  .tier {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    padding: 30px;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .tier-featured {
    border: 2px solid var(--accent);
    box-shadow: var(--shadow);
  }
  .flag {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 12px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .tier h3 {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .tier-sub {
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 4px;
  }
  .price {
    margin: 20px 0 6px;
  }
  .price .amount {
    font-family: var(--mono);
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .price .per {
    font-size: 13.5px;
    color: var(--muted);
  }
  .bill-note {
    font-size: 12px;
    color: var(--muted-2);
    font-family: var(--mono);
    margin-bottom: 18px;
    min-height: 18px;
  }
  .tier ul {
    list-style: none;
    margin-bottom: 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .tier li {
    font-size: 14px;
    color: var(--ink);
    padding-left: 24px;
    position: relative;
  }
  .tier li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--mint);
    font-weight: 700;
  }
  .tier .btn {
    margin-top: auto;
    width: 100%;
  }
  @media (max-width: 980px) {
    .tiers {
      grid-template-columns: 1fr;
    }
  }
</style>
