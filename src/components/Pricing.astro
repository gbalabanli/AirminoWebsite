---
/* Pricing matrix ported from docs/design/prototype_version_2.html #pricing
   (Developer $0 / Growth $239 / Enterprise Custom + monthly/annual switcher),
   re-skinned to Airmino tokens. Figures are placeholders until a real pricing
   decision lands — see docs/content-sources.md. Vanilla toggle, no framework. */
import { u } from '../lib/site';
import { getHomeCopy, type LocaleInput } from '../lib/i18n/home';
import { localizePath, normalizeLocale } from '../lib/i18n';
const growthMonthly = 239;
const growthAnnual = Math.round(growthMonthly * 0.8);

interface Props {
  locale?: LocaleInput;
}

const { locale } = Astro.props;
const activeLocale = normalizeLocale(locale);
const copy = getHomeCopy(activeLocale);
const localizedPath = (path: string) => u(localizePath(path, activeLocale));
---

<section class="band" id="pricing">
  <div class="wrap">
    <div class="sec-head pricing-head">
      <div class="kicker">{copy.pricing.kicker}</div>
      <h2>{copy.pricing.title}</h2>
      <p>{copy.pricing.description}</p>
      <div class="billing-toggle" role="group" aria-label={copy.pricing.billingLabel}>
        <button type="button" id="bill-monthly" aria-pressed="false" data-event="pricing-billing-monthly">{copy.pricing.monthly}</button>
        <button type="button" id="bill-annual" aria-pressed="true" class="is-active" data-event="pricing-billing-annual">
          {copy.pricing.annual} <span class="save">{copy.pricing.save}</span>
        </button>
      </div>
    </div>

    <div class="tiers">
      <div class="tier">
        <h3>{copy.pricing.tiers[0].name}</h3>
        <p class="tier-sub">{copy.pricing.tiers[0].description}</p>
        <div class="price"><span class="amount">$0</span><span class="per">{copy.pricing.perMonth}</span></div>
        <ul>
          {copy.pricing.tiers[0].features.map((feature) => <li>{feature}</li>)}
        </ul>
        <a class="btn btn-ghost" href={localizedPath('/#start')} data-trial-open data-event="pricing-start-developer">{copy.pricing.tiers[0].cta}</a>
      </div>

      <div class="tier tier-featured">
        <div class="flag">{copy.pricing.mostPopular}</div>
        <h3>{copy.pricing.tiers[1].name}</h3>
        <p class="tier-sub">{copy.pricing.tiers[1].description}</p>
        <div class="price">
          <span class="amount" id="price-growth" data-monthly={`$${growthMonthly}`} data-annual={`$${growthAnnual}`}>${growthAnnual}</span><span class="per">{copy.pricing.perMonth}</span>
        </div>
        <p class="bill-note" id="bill-note" data-annual-note={copy.pricing.annualNote} data-monthly-note={copy.pricing.monthlyNote}>{copy.pricing.annualNote}</p>
        <ul>
          {copy.pricing.tiers[1].features.map((feature) => <li>{feature}</li>)}
        </ul>
        <a class="btn btn-primary" href={localizedPath('/#start')} data-trial-open data-event="pricing-trial-growth">{copy.pricing.tiers[1].cta}</a>
      </div>

      <div class="tier">
        <h3>{copy.pricing.tiers[2].name}</h3>
        <p class="tier-sub">{copy.pricing.tiers[2].description}</p>
        <div class="price"><span class="amount">{copy.pricing.enterpriseAmount}</span></div>
        <ul>
          {copy.pricing.tiers[2].features.map((feature) => <li>{feature}</li>)}
        </ul>
        <a class="btn btn-ghost" href={localizedPath('/#start')} data-trial-open data-trial-interest="sales" data-event="pricing-contact-enterprise">{copy.pricing.tiers[2].cta}</a>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var monthly = document.getElementById('bill-monthly');
    var annual = document.getElementById('bill-annual');
    var price = document.getElementById('price-growth');
    var note = document.getElementById('bill-note');
    if (!monthly || !annual || !price) return;
    function set(mode) {
      var isAnnual = mode === 'annual';
      monthly.classList.toggle('is-active', !isAnnual);
      annual.classList.toggle('is-active', isAnnual);
      monthly.setAttribute('aria-pressed', String(!isAnnual));
      annual.setAttribute('aria-pressed', String(isAnnual));
      price.textContent = isAnnual ? price.getAttribute('data-annual') : price.getAttribute('data-monthly');
       if (note) note.textContent = isAnnual ? note.getAttribute('data-annual-note') : note.getAttribute('data-monthly-note');
    }
    monthly.addEventListener('click', function () { set('monthly'); });
    annual.addEventListener('click', function () { set('annual'); });
  })();
</script>

<style>
  .pricing-head {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }
  .billing-toggle {
    display: inline-flex;
    gap: 4px;
    margin-top: 24px;
    padding: 5px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper-2);
  }
  .billing-toggle button {
    font-family: inherit;
    font-size: 13.5px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .billing-toggle button.is-active {
    background: #fff;
    color: var(--accent);
    border-color: var(--line);
    box-shadow: var(--shadow);
  }
  .billing-toggle .save {
    font-size: 10px;
    text-transform: uppercase;
    font-weight: 700;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 2px 6px;
    border-radius: 5px;
    margin-left: 4px;
  }
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }
  .tier {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    padding: 30px;
    display: flex;
    flex-direction: column;
    position: relative;
  }
  .tier-featured {
    border: 2px solid var(--accent);
    box-shadow: var(--shadow);
  }
  .flag {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 12px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .tier h3 {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .tier-sub {
    font-size: 12.5px;
    color: var(--muted);
    margin-top: 4px;
  }
  .price {
    margin: 20px 0 6px;
  }
  .price .amount {
    font-family: var(--mono);
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .price .per {
    font-size: 13.5px;
    color: var(--muted);
  }
  .bill-note {
    font-size: 12px;
    color: var(--muted-2);
    font-family: var(--mono);
    margin-bottom: 18px;
    min-height: 18px;
  }
  .tier ul {
    list-style: none;
    margin-bottom: 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .tier li {
    font-size: 14px;
    color: var(--ink);
    padding-left: 24px;
    position: relative;
  }
  .tier li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--mint-ink);
    font-weight: 700;
  }
  .tier .btn {
    margin-top: auto;
    width: 100%;
  }
  @media (max-width: 980px) {
    .tiers {
      grid-template-columns: 1fr;
    }
  }
</style>
