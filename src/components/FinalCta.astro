---
import { u } from '../lib/site';
import { getHomeCopy, type LocaleInput } from '../lib/i18n/home';
import { localizePath, normalizeLocale } from '../lib/i18n';

interface Props {
  locale?: LocaleInput;
}

const { locale } = Astro.props;
const activeLocale = normalizeLocale(locale);
const copy = getHomeCopy(activeLocale);
const localizedPath = (path: string) => u(localizePath(path, activeLocale));
---

<section class="final" id="start">
  <div class="wrap">
    <h2>{copy.finalCta.title}</h2>
    <p>{copy.finalCta.description}</p>
    <div class="cta-row">
      <a class="btn btn-primary btn-lg" href="#" data-trial-open data-event="cta-start-trial">{copy.finalCta.startTrial}</a>
      <a class="btn btn-ghost btn-lg" href={localizedPath('/roi-calculator/')} data-event="cta-estimate">{copy.finalCta.estimate}</a>
    </div>
    <div class="micro">{copy.finalCta.micro}</div>
  </div>
</section>

<style>
  .final {
    background: var(--ink);
    color: #fff;
    padding: 88px 0;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .final::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(700px 340px at 50% 0%, rgba(59, 91, 255, 0.3), transparent 65%);
  }
  .final .wrap {
    position: relative;
  }
  .final h2 {
    font-size: clamp(28px, 3.6vw, 44px);
    margin-bottom: 18px;
    letter-spacing: -0.035em;
    line-height: 1.15;
    font-weight: 680;
  }
  .final p {
    color: #9aa4be;
    font-size: 17px;
    max-width: 560px;
    margin: 0 auto 34px;
    line-height: 1.6;
  }
  .final .cta-row {
    justify-content: center;
  }
  .final .btn-ghost {
    background: transparent;
    color: #fff;
    border-color: #33405e;
  }
  .final .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: #4a5878;
  }
  .final .micro {
    color: #5a6685;
    margin-top: 22px;
  }
</style>
