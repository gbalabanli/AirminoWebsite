---
import { getHomeCopy, type LocaleInput } from '../lib/i18n/home';

interface Props {
  locale?: LocaleInput;
}

const { locale } = Astro.props;
const copy = getHomeCopy(locale);
---

<section class="band">
  <div class="wrap">
    <div class="sec-head">
      <div class="kicker">{copy.acts.kicker}</div>
      <h2>{copy.acts.title}</h2>
    </div>
    <div class="acts">
      {copy.acts.items.map((item) => (
        <div class="act">
          <span class="n">{item.number}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .acts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
  }
  .act {
    padding: 32px 28px;
    border-right: 1px solid var(--line);
  }
  .act:last-child {
    border-right: none;
  }
  .act .n {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 16px;
    display: block;
  }
  .act h3 {
    font-size: 17px;
    margin-bottom: 11px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 680;
  }
  .act p {
    font-size: 14.2px;
    color: var(--muted);
    line-height: 1.65;
  }
  @media (max-width: 980px) {
    .acts {
      grid-template-columns: 1fr;
    }
    .act {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }
    .act:last-child {
      border-bottom: none;
    }
  }
</style>
