---
/* Trial signup modal (vanilla, no framework). Any element with
   [data-trial-open] opens it; [data-trial-interest="sales"] preselects the
   enterprise option. Submissions POST to FormSubmit (form-to-email service)
   which forwards to the trial inbox — the static site has no backend.
   No-JS fallback: trigger buttons keep their original hrefs (#start). */
const endpoint = 'https://formsubmit.co/ajax/dashzeofficial@gmail.com';
---

<div class="trial-overlay" id="trial-overlay" hidden>
  <div class="trial-dialog" role="dialog" aria-modal="true" aria-labelledby="trial-title">
    <button type="button" class="trial-close" id="trial-close" aria-label="Close signup form">✕</button>
    <div id="trial-body">
      <h2 id="trial-title">Start your 10,000-decision trial.</h2>
      <p class="trial-sub">Tell us where to send your API key. We reply within one business day.</p>
      <form id="trial-form" novalidate>
        <div class="trial-field">
          <label for="trial-name">Name</label>
          <input id="trial-name" name="name" type="text" autocomplete="name" required maxlength="120" />
        </div>
        <div class="trial-field">
          <label for="trial-email">Work email</label>
          <input id="trial-email" name="email" type="email" autocomplete="email" required maxlength="160" />
        </div>
        <div class="trial-field">
          <label for="trial-message">What will you decide? <span class="opt">(optional)</span></label>
          <textarea id="trial-message" name="message" rows="3" maxlength="1000" placeholder="e.g. fraud review for card payments"></textarea>
        </div>
        <input type="hidden" name="interest" id="trial-interest" value="trial" />
        <input type="text" name="_honey" class="trial-honey" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <p class="trial-error" id="trial-error" role="alert" hidden></p>
        <button type="submit" class="btn btn-primary btn-lg trial-submit" id="trial-submit" data-event="trial-form-submit">
          Request API key
        </button>
        <p class="trial-fine">Submitted via our form processor — see <a href="/gdpr/">GDPR &amp; data processing</a>.</p>
      </form>
    </div>
    <div id="trial-success" hidden>
      <h2>Request received.</h2>
      <p class="trial-sub">Thanks — your API key is on its way. Check your inbox within one business day.</p>
      <button type="button" class="btn btn-ghost" id="trial-done">Back to site</button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ endpoint }}>
  (function () {
    var overlay = document.getElementById('trial-overlay');
    var form = document.getElementById('trial-form');
    var error = document.getElementById('trial-error');
    var submitBtn = document.getElementById('trial-submit');
    var body = document.getElementById('trial-body');
    var success = document.getElementById('trial-success');
    var interest = document.getElementById('trial-interest');
    var lastFocus = null;
    if (!overlay || !form) return;

    function open(mode) {
      lastFocus = document.activeElement;
      if (mode === 'sales' && interest) interest.value = 'sales';
      overlay.hidden = false;
      document.body.style.overflow = 'hidden';
      var first = document.getElementById('trial-name');
      if (first) first.focus();
      if (window.plausible) window.plausible('trial-form-open');
    }
    function close() {
      overlay.hidden = true;
      document.body.style.overflow = '';
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    document.addEventListener('click', function (e) {
      var trigger = e.target && e.target.closest ? e.target.closest('[data-trial-open]') : null;
      if (trigger) {
        e.preventDefault();
        open(trigger.getAttribute('data-trial-interest'));
        return;
      }
      if (e.target === overlay) close();
    });
    document.getElementById('trial-close').addEventListener('click', close);
    document.getElementById('trial-done').addEventListener('click', close);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !overlay.hidden) close();
    });

    function showError(msg) {
      error.textContent = msg;
      error.hidden = false;
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      error.hidden = true;
      var name = document.getElementById('trial-name').value.trim();
      var email = document.getElementById('trial-email').value.trim();
      if (!name) { showError('Please enter your name.'); return; }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { showError('Please enter a valid work email.'); return; }
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
      var honey = form.querySelector('[name="_honey"]');
      var data = {
        name: name,
        email: email,
        interest: interest.value,
        message: document.getElementById('trial-message').value.trim(),
        _honey: honey ? honey.value : '',
        _subject: 'Airmino trial request — ' + name,
        _template: 'table',
        _captcha: 'false',
      };
      fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      }).then(function (res) {
        if (!res.ok) throw new Error('bad status');
        return res.json();
      }).then(function () {
        body.hidden = true;
        success.hidden = false;
        if (window.plausible) window.plausible('trial-form-success');
        if (document.dispatchEvent) document.dispatchEvent(new CustomEvent('airmino:intent', { detail: { event: 'trial-form-success' } }));
      }).catch(function () {
        showError('Could not send — check your connection and try again.');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Request API key';
      });
    });
  })();
</script>

<style>
  .trial-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(10, 14, 26, 0.55);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 48px 20px;
    overflow-y: auto;
  }
  .trial-overlay[hidden] {
    display: none;
  }
  .trial-dialog {
    position: relative;
    background: #fff;
    border-radius: 18px;
    padding: 36px;
    width: 100%;
    max-width: 520px;
    box-shadow: 0 32px 80px -20px rgba(10, 14, 26, 0.5);
  }
  .trial-dialog h2 {
    font-size: 24px;
    letter-spacing: -0.03em;
    font-weight: 680;
    margin-bottom: 8px;
    padding-right: 32px;
  }
  .trial-sub {
    font-size: 14.5px;
    color: var(--muted);
    margin-bottom: 24px;
    line-height: 1.6;
  }
  .trial-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    border: 1px solid var(--line);
    background: var(--paper-2);
    color: var(--muted);
    font-size: 14px;
    cursor: pointer;
  }
  .trial-close:hover {
    color: var(--ink);
    border-color: #c9d0e4;
  }
  .trial-field {
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
  }
  .trial-field label {
    font-size: 13px;
    font-weight: 620;
    margin-bottom: 6px;
  }
  .trial-field label .opt {
    font-weight: 400;
    color: var(--muted-2);
  }
  .trial-field input,
  .trial-field select,
  .trial-field textarea {
    font-family: inherit;
    font-size: 14.5px;
    padding: 11px 13px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    width: 100%;
  }
  .trial-field input:focus,
  .trial-field select:focus,
  .trial-field textarea:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }
  .trial-field textarea {
    resize: vertical;
  }
  .trial-honey {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
  }
  .trial-error {
    font-size: 13.5px;
    color: #c2410c;
    background: var(--warn-soft);
    border: 1px solid #fed7aa;
    border-radius: 9px;
    padding: 10px 13px;
    margin-bottom: 16px;
  }
  .trial-submit {
    width: 100%;
  }
  .trial-submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .trial-fine {
    font-size: 12px;
    color: var(--muted-2);
    margin-top: 14px;
    text-align: center;
  }
  .trial-fine a {
    color: var(--accent);
    font-weight: 600;
  }
  #trial-success {
    text-align: center;
    padding: 12px 0 4px;
  }
  #trial-success .btn {
    margin-top: 18px;
  }
  @media (max-width: 600px) {
    .trial-dialog {
      padding: 28px 22px;
    }
  }
</style>
