---
import { u } from '../lib/site';
/* All three cards link into /usage/ story tabs (the Ledgerline case-study
   page was removed; fraud proof now lives in the fraud-detection story). */
---

<section class="band alt">
  <div class="wrap">
    <div class="sec-head">
      <div class="kicker">Proof</div>
      <h2>What it looks like in production.</h2>
    </div>
    <div class="cases">
      <a class="case-card" href={u('/usage/#fraud-detection')} data-event="story-open-fraud-detection">
        <div class="co">Payments · Fraud review</div>
        <h4>Fraud review time cut from 4 hours to 90 seconds</h4>
        <div class="big">-62%</div>
        <div class="big-lbl">false positives blocking good customers</div>
        <div class="more">See the usage story →</div>
      </a>
      <a class="case-card" href={u('/usage/#support-routing')} data-event="story-open-support-routing">
        <div class="co">Support · Ticket routing</div>
        <h4>Ticket routing that adapts when the taxonomy changes</h4>
        <div class="big">-41%</div>
        <div class="big-lbl">misrouted tickets after taxonomy changes</div>
        <div class="more">See the usage story →</div>
      </a>
      <a class="case-card" href={u('/usage/#loan-prequal')} data-event="story-open-loan-prequal">
        <div class="co">Lending · Pre-qualification</div>
        <h4>Pre-qualification decisions in seconds, with an audit trail</h4>
        <div class="big">3.2×</div>
        <div class="big-lbl">faster pre-qualification than manual review</div>
        <div class="more">See the usage story →</div>
      </a>
    </div>
  </div>
</section>

<style>
  .cases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .case-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    padding: 26px;
    display: flex;
    flex-direction: column;
    transition: 0.18s;
  }
  a.case-card {
    cursor: pointer;
  }
  a.case-card:hover {
    border-color: #c9d0e4;
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }
  .case-card .co {
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
    font-weight: 660;
    margin-bottom: 14px;
    font-family: var(--mono);
  }
  .case-card h4 {
    font-size: 16.5px;
    line-height: 1.35;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
    font-weight: 680;
  }
  .case-card .big {
    font-family: var(--mono);
    font-size: 26px;
    font-weight: 700;
    color: var(--mint);
    letter-spacing: -0.03em;
    margin-bottom: 4px;
  }
  .case-card .big-lbl {
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .case-card .more {
    margin-top: auto;
    font-size: 13.5px;
    font-weight: 620;
    color: var(--accent);
  }
  @media (max-width: 980px) {
    .cases {
      grid-template-columns: 1fr;
    }
  }
</style>
