---
import { u } from '../lib/site';
import { getHomeCopy, type LocaleInput } from '../lib/i18n/home';
import { localizePath, normalizeLocale } from '../lib/i18n';
/* All three cards link into /usage/ story tabs (the Ledgerline case-study
   page was removed; fraud proof now lives in the fraud-detection story). */

interface Props {
  locale?: LocaleInput;
}

const { locale } = Astro.props;
const activeLocale = normalizeLocale(locale);
const copy = getHomeCopy(activeLocale);
const cases = [
  { ...copy.cases.items[0], value: '-62%', href: u(localizePath('/usage/#fraud-detection', activeLocale)), event: 'story-open-fraud-detection' },
  { ...copy.cases.items[1], value: '-41%', href: u(localizePath('/usage/#support-routing', activeLocale)), event: 'story-open-support-routing' },
  { ...copy.cases.items[2], value: '3.2×', href: u(localizePath('/usage/#loan-prequal', activeLocale)), event: 'story-open-loan-prequal' },
];
---

<section class="band alt">
  <div class="wrap">
    <div class="sec-head">
      <div class="kicker">{copy.cases.kicker}</div>
      <h2>{copy.cases.title}</h2>
    </div>
    <div class="cases">
      {cases.map((item) => (
        <a class="case-card" href={item.href} data-event={item.event}>
          <div class="co">{item.category}</div>
          <h3>{item.title}</h3>
          <div class="big">{item.value}</div>
          <div class="big-lbl">{item.valueLabel}</div>
          <div class="more">{item.more}</div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .cases {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .case-card {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
    padding: 26px;
    display: flex;
    flex-direction: column;
    transition: 0.18s;
  }
  a.case-card {
    cursor: pointer;
  }
  a.case-card:hover {
    border-color: #c9d0e4;
    box-shadow: var(--shadow);
    transform: translateY(-3px);
  }
  .case-card .co {
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
    font-weight: 660;
    margin-bottom: 14px;
    font-family: var(--mono);
  }
  .case-card h3 {
    font-size: 16.5px;
    line-height: 1.35;
    margin-bottom: 16px;
    letter-spacing: -0.02em;
    font-weight: 680;
  }
  .case-card .big {
    font-family: var(--mono);
    font-size: 26px;
    font-weight: 700;
    color: var(--mint-ink);
    letter-spacing: -0.03em;
    margin-bottom: 4px;
  }
  .case-card .big-lbl {
    font-size: 12.5px;
    color: var(--muted);
    margin-bottom: 18px;
  }
  .case-card .more {
    margin-top: auto;
    font-size: 13.5px;
    font-weight: 620;
    color: var(--accent);
  }
  @media (max-width: 980px) {
    .cases {
      grid-template-columns: 1fr;
    }
  }
</style>
