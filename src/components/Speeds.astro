---
import { getHomeCopy, type LocaleInput } from '../lib/i18n/home';

interface Props {
  locale?: LocaleInput;
}

const { locale } = Astro.props;
const copy = getHomeCopy(locale);
---

<section class="band alt">
  <div class="wrap">
    <div class="sec-head">
      <div class="kicker">{copy.speeds.kicker}</div>
      <h2>{copy.speeds.title}</h2>
      <p>{copy.speeds.description}</p>
    </div>
    <div class="speeds">
      {copy.speeds.items.map((item) => (
        <div class="speed">
          <span class="tag">{item.tag}</span>
          <h3 class="speed-h">{item.title}</h3>
          <p>{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .speeds {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .speed {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px;
    background: #fff;
    position: relative;
  }
  .speed .tag {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    background: var(--ink);
    color: #fff;
    padding: 3px 9px;
    border-radius: 5px;
    display: inline-block;
    margin-bottom: 14px;
  }
  .speed h3 {
    font-size: 16.5px;
    margin-bottom: 9px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 680;
  }
  .speed p {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.6;
  }
  @media (max-width: 980px) {
    .speeds {
      grid-template-columns: 1fr;
    }
  }
</style>
