---
import Base from '../layouts/Base.astro';
---

<Base title="Verdict — Decision Infrastructure for Automated Operations">
  <section class="wrap stub">
    <p class="kicker">Phase 01 scaffold</p>
    <h1>Site scaffold is live.</h1>
    <p>
      This stub is replaced in Phase 02 by the full Home/Platform port from
      <code>docs/design/index.html</code>.
    </p>
  </section>
</Base>

<style>
  .stub {
    padding: 96px 24px;
    max-width: 720px;
  }
  .kicker {
    font-size: 12px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 680;
    margin-bottom: 12px;
  }
  h1 {
    font-size: clamp(28px, 3.6vw, 42px);
    letter-spacing: -0.035em;
    margin-bottom: 16px;
  }
  p {
    color: var(--muted);
    font-size: 17px;
  }
  code {
    font-family: var(--mono);
    font-size: 14px;
    background: var(--paper-2);
    padding: 1px 5px;
    border-radius: 4px;
    border: 1px solid var(--line);
  }
</style>
