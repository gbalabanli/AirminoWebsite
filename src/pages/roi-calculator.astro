---
import Base from '../layouts/Base.astro';
import CalculatorIsland from '../components/CalculatorIsland.astro';
import { u } from '../lib/site';
import { getRoiCopy } from '../lib/i18n/secondary/roi';
import { getLocaleFromPath, localizePath, normalizeLocale, type LocaleInput } from '../lib/i18n';

interface Props {
  /** Locale supplied by a localized route wrapper; omitted means English. */
  locale?: LocaleInput;
}

const { locale: requestedLocale } = Astro.props;
const locale = normalizeLocale(requestedLocale ?? getLocaleFromPath(Astro.url.pathname));
const copy = getRoiCopy(locale);
const localizedPath = (path: string) => u(localizePath(path, locale));
---

<Base title={copy.page.title} description={copy.page.description} canonicalPath="/roi-calculator/" locale={locale}>
  <div class="calc-hero">
    <div class="wrap">
      <div class="crumb" style="color:var(--muted-2);margin-bottom:18px">
        <a href={localizedPath('/')}>{copy.breadcrumb.platform}</a>
        <span class="sep">{copy.breadcrumb.separator}</span>
        <span>{copy.breadcrumb.label}</span>
      </div>
      <h1>{copy.hero.title}</h1>
      <p>{copy.hero.description}</p>
    </div>
  </div>

  <CalculatorIsland locale={locale} />

  <div class="wrap">
    <div class="cta-row" style="margin-top:26px;margin-bottom:80px">
      <a class="btn btn-primary btn-lg" href="#" data-trial-open data-event="cta-start-trial">{copy.cta.startTrial}</a>
      <a class="btn btn-ghost btn-lg" href={localizedPath('/usage/#fraud-detection')} data-event="story-open-fraud-detection">{copy.cta.usageStory}</a>
    </div>
  </div>
</Base>

<style>
  .calc-hero {
    padding: 64px 0 44px;
    border-bottom: 1px solid var(--line);
    background: var(--paper-2);
  }
  .calc-hero .crumb a:hover {
    color: var(--ink);
  }
  .calc-hero h1 {
    font-size: clamp(28px, 3.6vw, 42px);
    letter-spacing: -0.035em;
    margin-bottom: 16px;
    line-height: 1.15;
    font-weight: 680;
  }
  .calc-hero p {
    font-size: 17px;
    color: var(--muted);
    max-width: 620px;
    line-height: 1.65;
  }
</style>
