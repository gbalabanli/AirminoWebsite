---
import Base from '../layouts/Base.astro';
import CalculatorIsland from '../components/CalculatorIsland.astro';
---

<Base title="ROI calculator — build your business case">
  <div class="calc-hero">
    <div class="wrap">
      <div class="crumb" style="color:var(--muted-2);margin-bottom:18px">
        <a href="/">Platform</a>
        <span class="sep">/</span>
        <span>ROI calculator</span>
      </div>
      <h1>Build your business case in 30 seconds.</h1>
      <p>Adjust the inputs to match your operation. Everything updates live — screenshot the result and paste it into your internal proposal.</p>
    </div>
  </div>

  <CalculatorIsland />

  <div class="wrap">
    <div class="cta-row" style="margin-top:26px;margin-bottom:80px">
      <a class="btn btn-primary btn-lg" href="#">Start 10,000-decision trial</a>
      <a class="btn btn-ghost btn-lg" href="/case-studies/ledgerline/">See a real deployment →</a>
    </div>
  </div>
</Base>

<style>
  .calc-hero {
    padding: 64px 0 44px;
    border-bottom: 1px solid var(--line);
    background: var(--paper-2);
  }
  .calc-hero .crumb a:hover {
    color: var(--ink);
  }
  .calc-hero h1 {
    font-size: clamp(28px, 3.6vw, 42px);
    letter-spacing: -0.035em;
    margin-bottom: 16px;
    line-height: 1.15;
    font-weight: 680;
  }
  .calc-hero p {
    font-size: 17px;
    color: var(--muted);
    max-width: 620px;
    line-height: 1.65;
  }
</style>
