---
import Base from '../layouts/Base.astro';
import { u } from '../lib/site';
import { getGdprCopy } from '../lib/i18n/secondary/gdpr';
import { getLocaleFromPath, localizePath, normalizeLocale, type LocaleInput } from '../lib/i18n';

interface Props {
  /** Locale supplied by a localized route wrapper; omitted means English. */
  locale?: LocaleInput;
}

const { locale: requestedLocale } = Astro.props;
const locale = normalizeLocale(requestedLocale ?? getLocaleFromPath(Astro.url.pathname));
const copy = getGdprCopy(locale);
const localizedPath = (path: string) => u(localizePath(path, locale));
---

<Base
  title={copy.page.title}
  description={copy.page.description}
  canonicalPath="/gdpr/"
  locale={locale}
>
  <div class="gdpr-hero">
    <div class="wrap">
      <div class="crumb">
        <a href={localizedPath('/')}>{copy.breadcrumb.home}</a>
        <span class="sep">{copy.breadcrumb.separator}</span>
        <span>{copy.breadcrumb.label}</span>
      </div>
      <div class="kicker">{copy.hero.kicker}</div>
      <h1>{copy.hero.title}</h1>
      <p>{copy.hero.description}</p>
    </div>
  </div>

  <section class="band">
    <div class="wrap gdpr-grid">
      <div class="gdpr-block">
        <h2>{copy.sections.process.title}</h2>
        <p>
          {copy.sections.process.beforeEndpoint}<code>{copy.sections.process.endpoint}</code>{copy.sections.process.afterEndpoint}
        </p>
      </div>
      <div class="gdpr-block">
        <h2>{copy.sections.whereRuns.title}</h2>
        <p>{copy.sections.whereRuns.body}</p>
      </div>
      <div class="gdpr-block">
        <h2>{copy.sections.noTraining.title}</h2>
        <p>{copy.sections.noTraining.body}</p>
      </div>
      <div class="gdpr-block">
        <h2>{copy.sections.rights.title}</h2>
        <p>{copy.sections.rights.body}</p>
        <p>{copy.sections.rights.contactBeforeEmail}<a href={`mailto:${copy.sections.rights.email}`}>{copy.sections.rights.email}</a>{copy.sections.rights.contactAfterEmail}</p>
      </div>
      <div class="gdpr-block">
        <h2>{copy.sections.subprocessors.title}</h2>
        <p>{copy.sections.subprocessors.body}</p>
      </div>
      <div class="gdpr-block">
        <h2>{copy.sections.security.title}</h2>
        <p>{copy.sections.security.body}</p>
      </div>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <div class="cta-row">
        <a class="btn btn-primary btn-lg" href={localizedPath('/usage/')} data-event="gdpr-see-usage">{copy.cta.usage}</a>
        <a class="btn btn-ghost btn-lg" href={localizedPath('/#pricing')} data-event="cta-pricing">{copy.cta.pricing}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .gdpr-hero {
    padding: 64px 0 44px;
    border-bottom: 1px solid var(--line);
    background: var(--paper-2);
  }
  .gdpr-hero .crumb a {
    color: var(--muted-2);
  }
  .gdpr-hero .crumb a:hover {
    color: var(--ink);
  }
  .gdpr-hero h1 {
    font-size: clamp(28px, 3.6vw, 42px);
    letter-spacing: -0.035em;
    margin-bottom: 16px;
    line-height: 1.15;
    font-weight: 680;
  }
  .gdpr-hero p {
    font-size: 17px;
    color: var(--muted);
    max-width: 680px;
    line-height: 1.65;
  }
  .gdpr-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .gdpr-block {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 26px;
  }
  .gdpr-block:first-child {
    grid-column: 1 / -1;
  }
  .gdpr-block h2 {
    font-size: 17px;
    letter-spacing: -0.02em;
    margin-bottom: 10px;
    font-weight: 680;
  }
  .gdpr-block p {
    font-size: 14.5px;
    color: var(--muted);
    line-height: 1.7;
  }
  .gdpr-block p + p {
    margin-top: 10px;
  }
  .gdpr-block code {
    font-family: var(--mono);
    font-size: 12.5px;
    background: var(--paper-2);
    padding: 1px 5px;
    border-radius: 4px;
    border: 1px solid var(--line);
  }
  .gdpr-block a {
    color: var(--accent);
    font-weight: 600;
  }
  @media (max-width: 980px) {
    .gdpr-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
