---
import Base from '../layouts/Base.astro';
import { u } from '../lib/site';
---

<Base title="Page not found">
  <section class="wrap stub">
    <p class="kicker">404</p>
    <h1>This page doesn't exist yet.</h1>
    <p><a href={u('/')}>Back to the homepage →</a></p>
  </section>
</Base>

<style>
  .stub {
    padding: 96px 24px;
    max-width: 720px;
  }
  .kicker {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.11em;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 12px;
  }
  h1 {
    font-size: clamp(28px, 3.6vw, 42px);
    letter-spacing: -0.035em;
    margin-bottom: 16px;
  }
  p a {
    color: var(--accent);
    font-weight: 600;
  }
</style>
