---
import Base from '../layouts/Base.astro';
import { u } from '../lib/site';
import { getNotFoundCopy } from '../lib/i18n/secondary/not-found';
import { getLocaleFromPath, localizePath, normalizeLocale, type LocaleInput } from '../lib/i18n';

interface Props {
  /** Locale supplied by a localized route wrapper; omitted means English. */
  locale?: LocaleInput;
}

const { locale: requestedLocale } = Astro.props;
const locale = normalizeLocale(requestedLocale ?? getLocaleFromPath(Astro.url.pathname));
const copy = getNotFoundCopy(locale);
const localizedPath = (path: string) => u(localizePath(path, locale));
---

<Base title={copy.pageTitle} description={copy.description} locale={locale}>
  <section class="wrap stub">
    <p class="kicker">404</p>
    <h1>{copy.title}</h1>
    <p><a href={localizedPath('/')}>{copy.backLink}</a></p>
  </section>
</Base>

<style>
  .stub {
    padding: 96px 24px;
    max-width: 720px;
  }
  .kicker {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.11em;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 12px;
  }
  h1 {
    font-size: clamp(28px, 3.6vw, 42px);
    letter-spacing: -0.035em;
    margin-bottom: 16px;
  }
  p a {
    color: var(--accent);
    font-weight: 600;
  }
</style>
