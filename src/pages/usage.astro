---
import Base from '../layouts/Base.astro';
import StoryTabs from '../components/StoryTabs.astro';
import StoryApiExample from '../components/StoryApiExample.astro';
import { STORIES } from '../lib/stories';
import { u } from '../lib/site';
import { getUsageCopy, type UsageStorySlug } from '../lib/i18n/secondary/usage';
import { localizePath, normalizeLocale, getLocaleFromPath, type LocaleInput } from '../lib/i18n';

interface Props {
  /** Locale supplied by a localized route wrapper; omitted means English. */
  locale?: LocaleInput;
}

const { locale: requestedLocale } = Astro.props;
const locale = normalizeLocale(requestedLocale ?? getLocaleFromPath(Astro.url.pathname));
const copy = getUsageCopy(locale);
const localizedPath = (path: string) => u(localizePath(path, locale));
---

<Base
  title={copy.page.title}
  description={copy.page.description}
  canonicalPath="/usage/"
  locale={locale}
>
  <div class="usage-hero">
    <div class="wrap">
      <div class="crumb">
        <a href={localizedPath('/')}>{copy.breadcrumb.platform}</a>
        <span class="sep">{copy.breadcrumb.separator}</span>
        <span>{copy.breadcrumb.label}</span>
      </div>
      <div class="kicker">{copy.hero.kicker}</div>
      <h1>{copy.hero.title}</h1>
      <p>
        {copy.hero.introBeforeApi}<code>{copy.hero.apiPath}</code>{copy.hero.introAfterApi}{copy.hero.staticNote}
      </p>
    </div>
  </div>

  <section class="band">
    <div class="wrap">
      <StoryTabs locale={locale} />

      {STORIES.map((s, i) => (
        <article
          id={`panel-${s.slug}`}
          data-story-panel={s.slug}
          role="tabpanel"
          aria-labelledby={`tab-${s.slug}`}
          hidden={i !== 0}
        >
          <div class="story-head">
            <div class="story-co">{copy.stories[s.slug as UsageStorySlug].company}</div>
            <h2>{copy.stories[s.slug as UsageStorySlug].headline}</h2>
            <p>{copy.stories[s.slug as UsageStorySlug].problem}</p>
          </div>

          <StoryApiExample storySlug={s.slug} locale={locale} />

          <div class="story-outcome">
            <div class="story-stat">{copy.stories[s.slug as UsageStorySlug].outcomeStat}</div>
            <div>
              <div class="story-stat-lbl">{copy.stories[s.slug as UsageStorySlug].outcomeLabel}</div>
              <div class="story-note">{copy.stories[s.slug as UsageStorySlug].outcomeNote}</div>
            </div>
          </div>
        </article>
      ))}

      <div class="cta-row" style="margin-top:36px">
        <a class="btn btn-primary btn-lg" href={localizedPath('/roi-calculator/')} data-event="cta-estimate">{copy.cta.estimate}</a>
        <a class="btn btn-ghost btn-lg" href={localizedPath('/#pricing')} data-event="cta-pricing">{copy.cta.pricing}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .usage-hero {
    padding: 64px 0 44px;
    border-bottom: 1px solid var(--line);
    background: var(--paper-2);
  }
  .usage-hero .crumb a {
    color: var(--muted-2);
  }
  .usage-hero .crumb a:hover {
    color: var(--ink);
  }
  .usage-hero h1 {
    font-size: clamp(28px, 3.6vw, 42px);
    letter-spacing: -0.035em;
    margin-bottom: 16px;
    line-height: 1.15;
    font-weight: 680;
  }
  .usage-hero p {
    font-size: 17px;
    color: var(--muted);
    max-width: 680px;
    line-height: 1.65;
  }
  .usage-hero p code {
    font-family: var(--mono);
    font-size: 14px;
    background: #fff;
    padding: 1px 6px;
    border-radius: 5px;
    border: 1px solid var(--line);
  }
  .story-head {
    max-width: 720px;
    margin-bottom: 26px;
  }
  .story-co {
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-2);
    font-weight: 660;
    margin-bottom: 12px;
    font-family: var(--mono);
  }
  .story-head h2 {
    font-size: clamp(22px, 2.6vw, 30px);
    letter-spacing: -0.03em;
    line-height: 1.2;
    font-weight: 680;
    margin-bottom: 12px;
  }
  .story-head p {
    font-size: 15.5px;
    color: var(--muted);
    line-height: 1.65;
  }
  .story-outcome {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    margin-top: 26px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--mint-soft);
  }
  .story-stat {
    font-family: var(--mono);
    font-size: 30px;
    font-weight: 700;
    color: var(--mint-ink);
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .story-stat-lbl {
    font-size: 14.5px;
    font-weight: 620;
    margin-bottom: 4px;
  }
  .story-note {
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.6;
  }
  article[hidden] {
    display: none;
  }
</style>
